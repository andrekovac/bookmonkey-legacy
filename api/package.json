{
  "name": "bookmonkey-api",
  "version": "0.1.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "db:reset": "node --disable-warning=ExperimentalWarning scripts/reset-db.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "import:csv": "node --disable-warning=ExperimentalWarning scripts/import-legacy-csv.js",
